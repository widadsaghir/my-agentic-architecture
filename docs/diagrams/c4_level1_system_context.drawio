        <!-- AAP Central System -->
        <mxCell id="aap" value="&lt;b&gt;Multi-Agent Architecture Platform (AAP)&lt;/b&gt;&lt;br&gt;[Système Logiciel Multi-Agents]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Orchestration autonome basée sur CrewAI et l'API Gemini.&lt;br&gt;Génère les dossiers d'architecture (DAT.md), les schémas C4 PlantUML&lt;br&gt;et les dossiers d'arbitrage selon le framework TOGAF ADM.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AED6F1;strokeColor=#1F618D;fontSize=14;fontColor=#000000;strokeWidth=3;arcSize=10;" vertex="1" parent="1">
