        <!-- User Actor -->
        <mxCell id="user" value="&lt;b&gt;Lead Architect&lt;/b&gt;&lt;br&gt;[Human-in-the-Loop]&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Fournit les consignes (--language, --input)&lt;br&gt;et valide les arbitrages finaux.&lt;/font&gt;" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2980B9;fontSize=14;fontColor=#000000;strokeWidth=2;" vertex="1" parent="1">
