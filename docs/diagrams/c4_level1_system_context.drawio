        <mxCell id="title" value="Multi-Agent Architecture Platform (AAP) — C4 Niveau 1 : Contexte Système" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1F618D;" vertex="1" parent="1">
