        <mxCell id="node_guard" value="&lt;b&gt;Garde-Fous IA (Azure AI Content Safety &amp;amp; NeMo)&lt;/b&gt;&lt;br&gt;Détection Anti-Prompt Injection, Jailbreak &amp;amp; Modération" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85C1E9;strokeColor=#2980B9;" vertex="1" parent="cont_azure">
          <mxGeometry x="30" y="130" width="540" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="node_llm" value="&lt;b&gt;Enclave Cognitive Privée (Azure OpenAI &amp;amp; Llama-3 70B GPU)&lt;/b&gt;&lt;br&gt;Modèles Multimodaux Dédiés | Quota PTU Réservé&lt;br&gt;&lt;font color='#27AE60'&gt;Engagement Contractuel : 0 Apprentissage sur Données Client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5DADE2;strokeColor=#1B4F72;fontColor=#FFFFFF;" vertex="1" parent="cont_azure">
          <mxGeometry x="30" y="230" width="540" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="node_search" value="&lt;b&gt;Azure AI Search (Vector Database)&lt;/b&gt;&lt;br&gt;Embeddings vectoriels des sinistres historiques&lt;br&gt;Graphes de corrélation de fraudes récurrentes" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#A9DFBF;strokeColor=#229954;" vertex="1" parent="cont_azure">
          <mxGeometry x="30" y="350" width="250" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="node_akv" value="&lt;b&gt;Azure Key Vault HSM&lt;/b&gt;&lt;br&gt;Module Cryptographique FIPS 140-2 L3&lt;br&gt;Gestion des clés CMK Azure &amp;amp; Secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;" vertex="1" parent="cont_azure">
          <mxGeometry x="320" y="350" width="250" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="node_pe" value="&lt;b&gt;Azure Private Endpoints&lt;/b&gt;&lt;br&gt;Points de terminaison 100% privés intégrés au VNet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#16A085;" vertex="1" parent="cont_azure">
          <mxGeometry x="30" y="480" width="540" height="60" as="geometry"/>
        </mxCell>

        <!-- Flux Connecteurs -->
        <mxCell id="f1" value="1. Déclaration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" source="node_gw" target="node_msk" parent="1"/>
