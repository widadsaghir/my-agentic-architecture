        <!-- Note Cartouche -->
        <mxCell id="cartouche_l3" value="&lt;b&gt;C4 Niveau 3 : Component Diagram — Architecture Hexagonale &amp;amp; DDD&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Clean Architecture : Ports &amp;amp; Adapters (Alistair Cockburn) + Domain-Driven Design (Eric Evans)&lt;br&gt;• Invariant : Zéro dépendance d'infrastructure dans le Core Domain (Spring, AWS SDK, Azure bannis du domaine)&lt;br&gt;• Testabilité : Couverture TDD 100% sur l'Agrégat Racine Claim et les Value Objects" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FEF9E7;strokeColor=#F1C40F;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="750" height="90" as="geometry"/>
        </mxCell>

