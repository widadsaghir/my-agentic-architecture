        <!-- Note Cartouche -->
        <mxCell id="cartouche_l4" value="&lt;b&gt;C4 Niveau 4 : Deployment Diagram — Topologie Réseau Physique Multi-AZ AWS &amp;amp; Azure&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Résilience : 3 Availability Zones AWS (eu-west-1a, 1b, 1c) avec bascule transparente RTO &amp;lt; 15 min, RPO = 0&lt;br&gt;• Réseau Hybride : AWS Direct Connect Gateway relié à Azure ExpressRoute via Equinix Cloud Exchange (10 Gbps)&lt;br&gt;• Isolation C2 MASSIF : Zéro IP publique sur les nœuds EKS, Aurora, Kafka et enclaves Azure OpenAI" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="90" as="geometry"/>
        </mxCell>

        <!-- Container AWS Region -->
