        <!-- Système Central -->
        <mxCell id="cont_system" value="Périmètre d'Étude AssurGlobal" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#AED6F1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="160" width="480" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="sys_omniclaim" value="&lt;b&gt;&lt;font style='font-size: 16px;'&gt;Plateforme OmniClaim AI&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Ingestion streaming temps réel (MSK Kafka)&lt;br&gt;• Traitement microservices conteneurisés (EKS)&lt;br&gt;• Enclave IA souveraine C2 MASSIF (Azure OpenAI)&lt;br&gt;• Détection de fraude &amp;amp; OCR devis multimodal&lt;br&gt;• Moteur de règles d'indemnisation &amp;amp; HITL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;strokeColor=#1B4F72;fontColor=#FFFFFF;align=left;spacing=15;" vertex="1" parent="cont_system">
          <mxGeometry x="40" y="140" width="400" height="320" as="geometry"/>
        </mxCell>

        <!-- Systèmes Tiers -->
