        <mxCell id="ext_legacy" value="&lt;b&gt;Système de Gestion Contrats (Legacy)&lt;/b&gt;&lt;br&gt;Vérification des franchises et plafonds garantis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;" vertex="1" parent="cont_tiers">
