        <mxCell id="ext_bank" value="&lt;b&gt;Passerelle Bancaire SEPA&lt;/b&gt;&lt;br&gt;Virements instantanés ISO 20022 (pacs.008)&lt;br&gt;Règlements &amp;lt; 2 000 € en temps réel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;" vertex="1" parent="cont_tiers">
