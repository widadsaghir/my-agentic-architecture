  <diagram id="diagram_c4_l1" name="C4 Niveau 1 System Context">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Note Cartouche -->
        <mxCell id="cartouche_l1" value="&lt;b&gt;C4 Niveau 1 : System Context Diagram — Écosystème Global OmniClaim AI&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• Framework : C4 Model (Simon Brown) / TOGAF 10 ADM Phase A (Architecture Vision)&lt;br&gt;• Frontières : AssurGlobal Core vs Partenaires Réglementés (Banques SEPA, Registres SIV, IDP)&lt;br&gt;• Gouvernance : Décaissement automatique &amp;lt; 2 000 € / Arbitrage Gestionnaire Humain (HITL)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#E8F8F5;strokeColor=#1ABC9C;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="750" height="90" as="geometry"/>
        </mxCell>

        <!-- Container Acteurs Humains -->
        <mxCell id="cont_acteurs" value="Acteurs Métier (Utilisateurs)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E6B0AA;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="320" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="act_client" value="&lt;b&gt;Assuré / Client Final&lt;/b&gt;&lt;br&gt;Application Mobile &amp;amp; Espace Web&lt;br&gt;Déclaration sinistre &amp;amp; photos" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FADBD8;strokeColor=#C0392B;" vertex="1" parent="cont_acteurs">
          <mxGeometry x="130" y="60" width="60" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="act_expert" value="&lt;b&gt;Artisans &amp;amp; Garages Agréés&lt;/b&gt;&lt;br&gt;Portail Partenaire B2B&lt;br&gt;Upload devis &amp;amp; factures PDF" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FADBD8;strokeColor=#C0392B;" vertex="1" parent="cont_acteurs">
          <mxGeometry x="130" y="240" width="60" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="act_hitl" value="&lt;b&gt;Gestionnaire Humain (HITL)&lt;/b&gt;&lt;br&gt;Portail Backoffice AssurGlobal&lt;br&gt;Arbitrage dossiers complexes &amp;gt; 2k€" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FADBD8;strokeColor=#C0392B;" vertex="1" parent="cont_acteurs">
          <mxGeometry x="130" y="420" width="60" height="80" as="geometry"/>
